@using Microsoft.AspNetCore.Identity
@using OnlineFoodOrderingSystem.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Foodie Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-logo">
            <span>🍕</span>
            <span>Foodie Admin</span>
        </div>
        <nav class="admin-nav">
            <a href="/Admin/Dashboard" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-fill"></i><span>Dashboard</span>
            </a>
            <a href="/Admin/Restaurant" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurant" ? "active" : "")">
                <i class="bi bi-shop-window"></i><span>Restaurants</span>
            </a>
            <a href="/Admin/Category" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                <i class="bi bi-tags-fill"></i><span>Categories</span>
            </a>
            <a href="/Admin/Food" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Food" ? "active" : "")">
                <i class="bi bi-egg-fried"></i><span>Foods</span>
            </a>
            <a href="/Admin/Order" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                <i class="bi bi-bag-check-fill"></i><span>Orders</span>
            </a>
            <a href="/Admin/Customer" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")">
                <i class="bi bi-people-fill"></i><span>Customers</span>
            </a>
            <a href="/Admin/Coupon" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coupon" ? "active" : "")">
                <i class="bi bi-ticket-perforated-fill"></i><span>Coupons</span>
            </a>
            <a href="/Admin/Report" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")">
                <i class="bi bi-bar-chart-fill"></i><span>Reports</span>
            </a>
            <div class="admin-nav-divider"></div>
            <a href="/" class="admin-nav-link">
                <i class="bi bi-house-fill"></i><span>View Site</span>
            </a>
            <form asp-action="Logout" asp-controller="Account" asp-area="Admin" method="post">
                <button class="admin-nav-link w-100 border-0 bg-transparent text-start text-danger">
                    <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                </button>
            </form>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
        <!-- Top Bar -->
        <header class="admin-topbar">
            <button class="btn btn-icon sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <div class="admin-topbar-title">@ViewData["Title"]</div>
            <div class="admin-topbar-user">
                <span class="text-muted small">@UserManager.GetUserName(User)</span>
                <div class="nav-avatar ms-2">A</div>
            </div>
        </header>

        <div class="admin-content p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
