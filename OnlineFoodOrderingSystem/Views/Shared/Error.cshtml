@model OnlineFoodOrderingSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="empty-icon text-danger" style="font-size: 80px;">⚠️</div>
    <h1 class="text-danger mt-3">Oops! Something went wrong.</h1>
    <p class="text-muted">We're sorry, but an unexpected error occurred while processing your request.</p>
    
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mt-4">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary mt-4 px-4">Return Home</a>
</div>
