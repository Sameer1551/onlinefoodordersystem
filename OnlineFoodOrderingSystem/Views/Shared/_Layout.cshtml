@using Microsoft.AspNetCore.Identity
@using OnlineFoodOrderingSystem.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Foodie - Order delicious food from the best restaurants near you. Fast delivery, easy payment." />
    <title>@ViewData["Title"] - Foodie</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(Context.Request.Cookies["darkMode"] == "true" ? "dark-mode" : "")">

<!-- Navbar -->
<nav class="navbar navbar-expand-lg main-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <span class="brand-icon">🍕</span>
            <span class="brand-name">Foodie</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <!-- Search -->
            <form class="d-flex mx-auto nav-search-form" action="/Home/Search" method="get">
                <div class="nav-search-wrap">
                    <i class="bi bi-search nav-search-icon"></i>
                    <input id="searchInput" class="form-control nav-search" type="search" name="q"
                           placeholder="Search for restaurants, cuisines..." value="@ViewBag.SearchQuery" autocomplete="off">
                </div>
            </form>
            <ul class="navbar-nav align-items-center gap-2 ms-3">
                <li class="nav-item">
                    <a class="nav-link" href="/Restaurant"><i class="bi bi-shop"></i> Restaurants</a>
                </li>
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
                {
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="/Cart" id="cartNavLink">
                            <i class="bi bi-bag2"></i>
                            <span class="badge cart-badge" id="cartCount">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="/Notification" id="notifNavLink">
                            <i class="bi bi-bell"></i>
                            <span class="badge notif-badge d-none" id="notifCount">0</span>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-user-btn dropdown-toggle" data-bs-toggle="dropdown" href="#">
                            <div class="nav-avatar">@UserManager.GetUserName(User)?.Substring(0, 1).ToUpper()</div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                            <li><h6 class="dropdown-header">@UserManager.GetUserName(User)</h6></li>
                            <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="/Order/History"><i class="bi bi-clock-history me-2"></i>My Orders</a></li>
                            <li><a class="dropdown-item" href="/Wishlist"><i class="bi bi-heart me-2"></i>Wishlist</a></li>
                            <li><a class="dropdown-item" href="/Address"><i class="bi bi-geo-alt me-2"></i>Addresses</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-action="Logout" asp-controller="Account" method="post">
                                    <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else if (!SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm px-3" href="/Account/Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-3" href="/Account/Register">Sign Up</a>
                    </li>
                }
                <li class="nav-item">
                    <button class="btn btn-icon" id="darkModeToggle" title="Toggle dark mode">
                        <i class="bi bi-moon-fill"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" style="z-index:1100"></div>

<!-- Cart Conflict Modal -->
<div class="modal fade" id="cartConflictModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">🛒 Start a new cart?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Your cart has items from <strong id="conflictRestaurantName"></strong>. Adding this item will clear your current cart.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep current cart</button>
                <button type="button" class="btn btn-primary" id="confirmClearCart">Yes, start fresh</button>
            </div>
        </div>
    </div>
</div>

<main>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="main-footer mt-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="footer-brand"><span>🍕</span> Foodie</div>
                <p class="text-muted mt-2">Delicious food, delivered fast. Order from the best restaurants near you.</p>
            </div>
            <div class="col-lg-2">
                <h6 class="footer-heading">Quick Links</h6>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/Restaurant">Restaurants</a></li>
                    <li><a href="/Order/GuestTrack">Track Order</a></li>
                </ul>
            </div>
            <div class="col-lg-2">
                <h6 class="footer-heading">Account</h6>
                <ul class="footer-links">
                    <li><a href="/Account/Login">Login</a></li>
                    <li><a href="/Account/Register">Sign Up</a></li>
                    <li><a href="/Account/Profile">Profile</a></li>
                </ul>
            </div>
            <div class="col-lg-4 text-lg-end">
                <p class="text-muted small">© 2024 Foodie. All rights reserved.</p>
            </div>
        </div>
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
