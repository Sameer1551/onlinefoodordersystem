@model List<OnlineFoodOrderingSystem.Models.Entities.Wishlist>
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-5">
    <h1 class="section-title mb-4">My Wishlist</h1>

    @if (!Model.Any())
    {
        <div class="empty-state py-5">
            <div class="empty-icon">❤️</div>
            <h4>Your wishlist is empty</h4>
            <p class="text-muted">Save your favorite foods to find them easily later.</p>
            <a href="/Restaurant" class="btn btn-primary mt-3">Browse Restaurants</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3" id="wishlist_@item.FoodId">
                    <div class="menu-item-card h-100 flex-column">
                        <div class="menu-item-img-wrap w-100" style="height:150px">
                            <img src="@(item.FoodItem?.ImageUrl ?? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&h=400&fit=crop")"
                                 alt="@item.FoodItem?.Name" class="menu-item-img h-100 object-fit-cover" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&h=400&fit=crop'">
                            <button class="btn btn-icon position-absolute top-0 end-0 m-2 bg-white rounded-circle text-danger shadow-sm"
                                    onclick="toggleWishlist(@item.FoodId)">
                                <i class="bi bi-heart-fill"></i>
                            </button>
                        </div>
                        <div class="menu-item-body flex-grow-1 p-3">
                            <span class="veg-indicator @(item.FoodItem!.IsVeg ? "veg" : "nonveg") mb-1"></span>
                            <h6 class="mb-1">@item.FoodItem.Name</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-shop me-1"></i>@item.FoodItem.Restaurant?.Name</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="fw-600">₹@item.FoodItem.Price</span>
                                <button class="btn btn-primary btn-sm add-to-cart-btn position-static"
                                        onclick="addToCart(this, @item.FoodId)">
                                    <i class="bi bi-plus"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    function toggleWishlist(foodId) {
        $.post('/Wishlist/Toggle', { foodId: foodId }, function(res) {
            if (!res.added) {
                $('#wishlist_' + foodId).fadeOut(function() { $(this).remove(); });
            }
        });
    }
</script>
}
