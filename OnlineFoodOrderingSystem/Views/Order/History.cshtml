@model List<OnlineFoodOrderingSystem.Models.Entities.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-5">
    <h1 class="section-title mb-4">My Orders</h1>

    @if (!Model.Any())
    {
        <div class="empty-state py-5">
            <div class="empty-icon">📦</div>
            <h3>No orders yet</h3>
            <p class="text-muted">Place your first order and it will show up here!</p>
            <a href="/Restaurant" class="btn btn-primary mt-3">Browse Restaurants</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="order-history-card">
                <div class="order-history-header">
                    <div>
                        <span class="order-history-id">#ORD@(order.OrderId.ToString("D5"))</span>
                        <span class="text-muted small ms-2">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                    <span class="status-pill status-@order.Status.ToLower()">@order.Status</span>
                </div>
                <div class="order-history-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shop text-primary"></i>
                        <span class="fw-600">@order.Restaurant?.Name</span>
                    </div>
                    <div class="order-history-items text-muted small">
                        @string.Join(", ", order.OrderItems.Select(i => $"{i.FoodItem?.Name} ×{i.Quantity}"))
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-700">₹@order.TotalAmount</span>
                        <div class="d-flex gap-2">
                            <a href="/Order/Track/@order.OrderId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-geo-alt me-1"></i>Track
                            </a>
                            <form asp-action="Reorder" asp-controller="Order" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@order.OrderId">
                                <button class="btn btn-sm btn-primary">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Reorder
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
