@model OnlineFoodOrderingSystem.Models.ViewModels.AddressViewModel
@{
    ViewData["Title"] = Model.AddressId == 0 ? "Add Address" : "Edit Address";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-body shadow-sm rounded-4">
                <h3 class="mb-4">@ViewData["Title"]</h3>
                <form asp-action="@(Model.AddressId == 0 ? "Add" : "Edit")" method="post">
                    @if (Model.AddressId != 0) { <input type="hidden" asp-for="AddressId" /> }
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-floating mb-3">
                        <select asp-for="Label" class="form-select" id="label">
                            <option value="Home">Home</option>
                            <option value="Work">Work</option>
                            <option value="Other">Other</option>
                        </select>
                        <label for="label">Label</label>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="AddressLine" class="form-control" id="line" style="height: 100px" placeholder="Address"></textarea>
                        <label for="line">Complete Address</label>
                        <span asp-validation-for="AddressLine" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="City" class="form-control" id="city" placeholder="City">
                                <label for="city">City</label>
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="PinCode" class="form-control" id="pin" placeholder="Pin Code">
                                <label for="pin">Pin Code</label>
                                <span asp-validation-for="PinCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="State" class="form-control" id="state" placeholder="State">
                        <label for="state">State</label>
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsDefault" class="form-check-input" id="isDef">
                        <label class="form-check-label small" for="isDef">Set as default address</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-50">Save Address</button>
                        <a href="/Address" class="btn btn-outline-secondary w-50">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
