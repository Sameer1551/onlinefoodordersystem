@model List<OnlineFoodOrderingSystem.Models.Entities.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="section-title mb-4">Notifications</h1>

            @if (!Model.Any())
            {
                <div class="empty-state py-5">
                    <div class="empty-icon">🔔</div>
                    <h4>No new notifications</h4>
                    <p class="text-muted">We'll let you know when there's an update on your orders.</p>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var n in Model)
                    {
                        <a href="@(n.Link ?? "#")" class="notification-item @(!n.IsRead ? "unread" : "") text-decoration-none">
                            <div class="d-flex align-items-center gap-3">
                                <div class="notification-icon bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px">
                                    <i class="bi bi-bag-check"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <p class="mb-0 text-dark">@n.Message</p>
                                    <small class="text-muted">@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Clear badge when viewing this page
        $.post('/Notification/MarkRead', function() {
            $('#notifBadge').addClass('d-none').text('0');
        });
    });
</script>
}
