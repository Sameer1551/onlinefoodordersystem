@model List<OnlineFoodOrderingSystem.Models.Entities.Category>
@{
    ViewData["Title"] = "Manage Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Categories</h4>
    <a href="/Admin/Category/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>Add New</a>
</div>

<div class="card border-0 shadow-sm rounded-4" style="max-width:800px">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="80">Image</th>
                    <th>Name</th>
                    <th width="100">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <img src="@(c.ImageUrl ?? "https://images.unsplash.com/photo-1590846406792-0adc7f928a18?w=200&h=200&fit=crop")"
                                 class="rounded" width="40" height="40" style="object-fit:cover" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1590846406792-0adc7f928a18?w=200&h=200&fit=crop'">
                        </td>
                        <td class="fw-600">@c.Name</td>
                        <td>
                            <a href="/Admin/Category/Edit/@c.CategoryId" class="btn btn-sm btn-icon"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete category?')">
                                <input type="hidden" name="id" value="@c.CategoryId" />
                                <button class="btn btn-sm btn-icon text-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
