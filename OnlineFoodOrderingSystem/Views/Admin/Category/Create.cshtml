@model OnlineFoodOrderingSystem.Models.Entities.Category
@{
    ViewData["Title"] = Model.CategoryId == 0 ? "Add Category" : "Edit Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-4" style="max-width:600px; margin:0 auto">
    <div class="card-body p-4">
        <h4 class="mb-4">@ViewData["Title"]</h4>
        <form asp-action="@(Model.CategoryId == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
            @if (Model.CategoryId != 0) { <input type="hidden" asp-for="CategoryId" /> }
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Name">
                <label asp-for="Name">Category Name</label>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label small">Category Image</label>
                <input type="file" name="imageFile" class="form-control">
                @if(Model.ImageUrl != null) { <img src="@Model.ImageUrl" height="60" class="mt-2 rounded"> }
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Save Category</button>
                <a href="/Admin/Category" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
