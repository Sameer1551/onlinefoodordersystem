@model OnlineFoodOrderingSystem.Models.Entities.Coupon
@{
    ViewData["Title"] = "Create Coupon";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var restaurants = ViewBag.Restaurants as List<OnlineFoodOrderingSystem.Models.Entities.Restaurant>;
}

<div class="card border-0 shadow-sm rounded-4" style="max-width:600px; margin:0 auto">
    <div class="card-body p-4">
        <h4 class="mb-4">Create New Coupon</h4>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Code" class="form-control text-uppercase" placeholder="Code">
                <label asp-for="Code">Coupon Code (e.g. WELCOME50)</label>
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <div class="form-floating">
                        <select asp-for="DiscountType" class="form-select">
                            <option value="Percentage">Percentage (%)</option>
                            <option value="Flat">Flat Amount (₹)</option>
                        </select>
                        <label asp-for="DiscountType">Discount Type</label>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-floating">
                        <input asp-for="DiscountValue" class="form-control" placeholder="Value">
                        <label asp-for="DiscountValue">Discount Value</label>
                        <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <div class="form-floating">
                        <input asp-for="MinOrderValue" class="form-control" placeholder="Min Amount">
                        <label asp-for="MinOrderValue">Min Order Amount (₹)</label>
                        <span asp-validation-for="MinOrderValue" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-floating">
                        <input asp-for="ExpiryDate" type="date" class="form-control">
                        <label asp-for="ExpiryDate">Expiry Date</label>
                        <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <select asp-for="RestaurantId" class="form-select">
                    <option value="">All Restaurants (Global)</option>
                    @if(restaurants != null) {
                        foreach(var r in restaurants) {
                            <option value="@r.RestaurantId">@r.Name</option>
                        }
                    }
                </select>
                <label asp-for="RestaurantId">Specific Restaurant (Optional)</label>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" checked>
                <label asp-for="IsActive" class="form-check-label">Is Active</label>
            </div>

            <div>
                <button type="submit" class="btn btn-primary px-4">Create Coupon</button>
                <a href="/Admin/Coupon" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
