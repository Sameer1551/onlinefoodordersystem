@model OnlineFoodOrderingSystem.Models.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-body shadow-sm rounded-4">
                <div class="text-center mb-4">
                    <div class="nav-avatar mx-auto" style="width:64px;height:64px;font-size:28px">
                        @Model.FullName?.Substring(0, 1).ToUpper()
                    </div>
                    <h4 class="mt-3">@Model.FullName</h4>
                    <p class="text-muted small">@Model.Email</p>
                </div>
                <form asp-action="Profile" asp-controller="Account" method="post">
                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control" id="profName" placeholder="Name">
                        <label for="profName">Full Name</label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Phone" class="form-control" id="profPhone" placeholder="Phone">
                        <label for="profPhone">Phone Number</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
